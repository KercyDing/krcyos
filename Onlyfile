!label false

% Clean all the cache
clean():
    rm -rf .zig-cache zig-out zig-pkg
    echo 'Clean done.'

% Format all .zig
fmt():
    zig fmt .
    echo 'Formatted.'

% Build in different environments
[build]
% Build for QEMU
qemu(log_level="info", kernel_tests="true"):
    zig build -Dboard=qemu_virt -Dlog={{ log_level }} -Dtests={{ kernel_tests }}
    echo 'Success.'

% Build for real board
real():
    zig build -Dboard=real_board
    echo 'Success.'

% Run in different environments
[run]
% Run in QEMU
qemu(log_level="info", kernel_tests="true"):
    zig build run -Dboard=qemu_virt -Dlog={{ log_level }} -Dtests={{ kernel_tests }}

% Build for real board
real():
    zig build run -Dboard=real_board
